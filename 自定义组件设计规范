- **WeCom JS-SDK**: 企业微信 JS-SDK 能力。
  - **说明**: 在企业微信环境下如果安装了伙伴云的应用，则系统支持使用应用的授权来初始化企业微信的 JS-SDK，初始化完成后则可任意调用企业微信 JS-SDK 提供的 JSAPI 了。
  - **开发指南**: [企业微信 JS-SDK 开发指南](https://developer.work.weixin.qq.com/document/path/90546)。
  - **用法**: `import { registerJsSdk, BrowserHelper } from '@huoban/page-client-toolkit';`
  - **示例代码**: 以在企业微信聊天侧边栏中“分享接口 - 自定义转发到会话”为例，演示如何在 JS 脚本中调用企业微信的 JSAPI。
    ```javascript
    // 引入页面客户端工具包，并提取出 registerJsSdk(第三方 JS-SDK 初始化方法)、HBUI(UI 组件)、BrowserHelper(浏览器环境)
    import { registerJsSdk, HBUI, BrowserHelper } from '@huoban/page-client-toolkit';
    // 从 HBUI 中获取 createMessage 方法
    const { createMessage } = HBUI;
    // 执行 createMessage 方法创建出 Message 全局提示对象
    const Message = createMessage();

    export default function (props) {
      const sendMessage = async () => {
        // 通过浏览器环境判断是否在企业微信的环境内
        if (!BrowserHelper?.isWechatWork()) {
          Message.info('请在企业微信客户端内使用');
          return false;
        }
        // 调用前先要初始化注册企微的 JS-SDK，并传入需要使用的 jsApiList
        const isRegisterSuccess = await registerJsSdk({
          weChatWorkOptions: {
            appType: 'priv', // 指定使用当前企业的哪个企业微信应用来初始化，默认不设置为选择主应用，priv 自建应用
            isAgentConfig: true, // 使用 wx.agentConfig 方式初始化企微的 JS-SDK 授权
            jsApiList: ["sendChatMessage"] // 传入需要使用的企微 JS-SDK 的 jsapi 列表
          }
        });
        // 如果注册失败，则提示错误
        if (!isRegisterSuccess) {
          Message.info('初始化企业微信 JS-SDK 失败');
          return false;
        }
        // 调用企微 JS-SDK 的 wx 对象前，判断其是否存在
        if (typeof wx !== 'undefined') {
          // 调用企微 JS-SDK 提供的方法
          wx.invoke('sendChatMessage', {
            msgtype:"news", //消息类型，必填，支持文本(“text”)，图片(“image”)，视频(“video”)，文件(“file”)，H5(“news”）和小程序(“miniprogram”)
            news:
            {
                link: "https://work.weixin.qq.com", //H5消息页面url 必填
                title: "企业微信 - 连接创造价值", //H5消息标题
                desc: "来自自定义组件的分享", //H5消息摘要
                imgUrl: "https://wwcdn.weixin.qq.com/node/wework/images/202201062104.366e5ee28e.png", //H5消息封面图片URL
            }
          }, function(res) {
            if (res.err_msg == "sendChatMessage:ok") {
              Message.success('发送成功');
            } else {
              console.debug(JSON.stringify(res));
              Message.warning('发送失败');
            }
          })
        } else {
          Message.info('请在企业微信客户端内使用');
        }
      };
      return (
        <div onClick={sendMessage} className="flex justify-center items-center w-full h-full cursor-pointer">
          发送“企业微信 - 连接创造价值”到聊天框
        </div>
      );
    }
    ```
