    **JavaScript**:
    ```javascript
    import React, { useEffect, useRef } from 'react';
    import _ from 'lodash';
    // 引入页面客户端工具包，并提取出 amap 对象
    import { amap, HBUI } from '@huoban/page-client-toolkit';

    // 从 amap 中获得 getAMapLoader 方法
    const { getAMapLoader } = amap;
    // 从 HBUI 中获得 Icon 组件，用于显示空提示中的图标
    const { Icon } = HBUI;

    // 根据数值字段的设置规则来格式化数值结果
    const formatNumericField = (value, config) => {
      if (typeof value === 'number' && !isNaN(value)) {
        const conf = config.config;
        const value2 = conf?.is_percent === 1 ? value * 100 : value;
        const value3 = conf?.precision === '' ? value2 : value2.toFixed(parseInt(conf?.precision, 10));
        const value4 = conf?.separator === 'thousands' ? value3.toLocaleString() : value3;
        const surfix = conf?.unit_position === 'surfix' ? conf?.unit_suffix : '';
        const prefix = conf?.unit_position === 'prefix' ? conf?.unit_prefix : '';
        return prefix + value4 + surfix;
      } else {
        return value;
      }
    };

    export default function (props) {
      const mapContainer = useRef(null); // 渲染地图的容器
      const mapInstance = useRef(null); // 存储地图的实例
      const mapCluster = useRef(null); // 存储地图的聚合插件

      const item_data  = props?.data?.item_data || {};
      const hasNumericField = item_data?.field_configs?.value && item_data?.field_configs?.value?.data_type === 'numeric' ? true : false;

      const setMapData = () => {
        if (!mapInstance.current || !mapCluster.current) return; // 当地图实例不存在，则不再继续执行

        // 创建聚合点数据
        const points = [];
        item_data?.items.map((item) => {
          points.push({
            item: item,
            weight: 1,
            lnglat: [item?.position?.raw_value?.coordinate?.lon, item?.position?.raw_value?.coordinate?.lat]
          });
        });

        // 动态计算地图中心点及缩放层级
        let minLng = Infinity;
        let maxLng = -Infinity;
        let minLat = Infinity;
        let maxLat = -Infinity;

        points.map((point) => {
          const lng = point.lnglat[0];
          const lat = point.lnglat[1];
          if (lat < minLat) minLat = lat;
          if (lat > maxLat) maxLat = lat;
          if (lng < minLng) minLng = lng;
          if (lng > maxLng) maxLng = lng;        
        });

        const center = [(minLng + maxLng) / 2, (minLat + maxLat) / 2];

        // 创建经纬度边界对象
        const bounds = new AMap.Bounds(
          [minLng, minLat],
          [maxLng, maxLat]
        );

        // 计算合适的缩放层级和中心点
        const view = mapInstance.current.getFitZoomAndCenterByBounds(bounds, [40, 40, 40, 40]);
        // 设置地图中心点及缩放层级
        mapInstance.current.setZoomAndCenter(view[0], [view[1].lng, view[1].lat], false, 1000);

        // 设置聚合数据
        mapCluster.current.setData(points);
      }

      useEffect(() => {
        let isMounted = true; // 地图组件挂载状态标识

        const initMap = async () => {
          try {
            const AMapLoader = await getAMapLoader(); // 异步加载地图的 SDK 包
            const AMap = await AMapLoader.load(); // 将地图 SDK 加载到的组件中
            
            if (!mapContainer.current || !isMounted) return; // 当地图实例存在或地图组件已经挂载，则不再继续初始化

            // 1. 创建地图：调用地图 SDK 提供的方法创建地图实例，有了地图实例后就可以按照地图的开发文档进行开发
            mapInstance.current = new AMap.Map(mapContainer.current, {
              zoom: 15, // 地图级别
              resizeEnable: true
            });

            // 2. 初始化地图风格
            mapInstance.current.setMapStyle(props.env.theme_mode === 'dark' ? 'amap://styles/dark' : 'amap://styles/normal');

            // 3. 设置聚合点样式
            var _renderClusterMarker = function (context) {
              //context 为回调参数，包含如下属性 marker:当前聚合点，count:当前聚合点内的点数量
              const valueSum = _.chain(context.clusterData)
                .map(item => _.get(item, '_amapMarker.originData[0]', []))
                .flatten()
                .sumBy('item.value.raw_value')
                .value();
              
              const valueSumString = hasNumericField ? formatNumericField(valueSum, item_data?.field_configs?.value) : 0;
              const clusterCount = hasNumericField ? valueSumString : context.count; //聚合点内点数量
              
              context.marker.setContent(
                '<div class="cluster-maker">' + clusterCount + "</div>"
              );
          
              // 监听聚合点的 click 事件：地图级别+1
              context.marker.on('click', () => {
                if (mapInstance.current) {
                  mapInstance.current.setZoomAndCenter(mapInstance.current.getZoom() + 1, context.marker.getPosition(), false, 500);
                }
              });
            };
            
            // 4. 设置非聚合点样式
            var _renderMarker = function (context) {
              //context 为回调参数，包含如下属性 marker:当前非聚合点
              const item = context?.data?.[0]?.item;
              
              context.marker.setContent(
                `<div class="maker">
                  <div class="title">${item?.title?.value}</div>
                  ${hasNumericField && item?.value?.value ? `<div class="desc">${item_data?.field_configs?.value?.name}：${item?.value?.value}</div>` : ''}
                </div>`
              );
              context.marker.setAnchor('top-center');
              
              // 监听 marker 的 click 事件：打开数据详情
              context.marker.on('click', (e) => {
                if (item_data && typeof item_data?.onItemClick === 'function') {
                  item_data?.onItemClick(item);
                }
              });
            };
        
            // 5. 添加聚合组件
            mapInstance.current.plugin(["AMap.MarkerCluster"], function () {
              mapCluster.current = new AMap.MarkerCluster(
                mapInstance.current, //地图实例
                [], //海量点数据，数据中需包含经纬度信息字段 lnglat
                {
                  gridSize: 100, //数据聚合计算时网格的像素大小
                  renderClusterMarker: _renderClusterMarker, //上述步骤的自定义聚合点样式
                  renderMarker: _renderMarker, //上述步骤的自定义非聚合点样式
                }
              );
            });

            // 6. 设置地图数据
            setMapData();

          } catch (error) {
            console.debug('地图初始化失败:', error);
          }
        };

        initMap();  // 初始化地图
        
        return () => { // 清理函数
          isMounted = false; // 标记地图组件已卸载
          if (mapInstance.current) { // 销毁地图实例
            console.debug('destroy');
            mapInstance.current.destroy();
            mapInstance.current = null;
          }
        };
      }, []);

      useEffect(() => {
        // 设置地图数据
        setMapData();
      }, [props.data]);

      // 监控 props.env.theme_mode 变化来设置地图的深浅色
      useEffect(() => {
        if (mapInstance.current) {
          mapInstance.current.setMapStyle(props.env.theme_mode === 'dark' ? 'amap://styles/dark' : 'amap://styles/normal');
        }
      }, [props.env.theme_mode]);

      // 点样式
      const setting = props?.custom_setting;
      const style = {
        '--cluster-bg-color': setting?.cluster_bg_color ? setting?.cluster_bg_color : 'transparent',
        '--cluster-font-color': setting?.cluster_font_color ? setting?.cluster_font_color : 'var(--page-body-color-follow)',
        '--point-bg-color': setting?.point_bg_color ? setting?.point_bg_color : 'transparent',
        '--point-font-color': setting?.point_font_color ? setting?.point_font_color : 'var(--page-body-color-follow)',
      };

      // 如果获取到的数据少于 1 条，则给出空提示
      if (item_data && item_data?.items.length < 1) {
        return (
          <div className="empty">
            <Icon size="middle" type="tray-solid" fontSource="hbicon" />
            暂无数据
          </div>
        );
      }

      return (
        <div ref={mapContainer} className="w-full h-full rounded-[9px]" style={style} />
      );
    };
    ```

