      const button_class = "hover:bg-[var(--page-widget-main-4)] leading-[20px] w-full py-2 px-2 rounded-[6px] flex items-center justify-center flex-row gap-[4px] border border-[var(--page-widget-main-8)] cursor-pointer";
      
      return (
        <div className="p-0 flex items-center flex-col gap-[10px]">
          <div onClick={() => openURL({ type: 'page', id: 7000000002365318, openNewTab: false })} className={button_class}>
            打开“Schema 组件描述文件”页面
          </div>
          <div onClick={() => openURL({ type: 'table', id: table_id, openNewTab: false })} className={button_class}>
            打开数据源表格
          </div>
          <div onClick={() => openURL({ type: 'item_create', id: 'item_data', openNewTab: false })} className={button_class}>
            打开数据源数据创建（数据源key名）
          </div>
          <div onClick={() => openURL({ type: 'item_create', id: table_id, openNewTab: false })} className={button_class}>
            打开数据源数据创建（数据源表格ID）
          </div>
          <div onClick={() => openURL({ type: 'item', id: item_id, openNewTab: false })} className={button_class}>
            打开数据源数据详情
          </div>
          <div onClick={() => openURL({ type: 'item_edit', id: item_id, openNewTab: false })} className={button_class}>
            打开数据源数据编辑
          </div>
          <div onClick={() => openURL({ type: 'url', url: 'https://www.domain.com', openNewTab: true })} className={button_class}>
            打开“https://www.domain.com”链接
          </div>
        </div>
      );
    }
    ```

- **previewFiles({ files, currentIndex, downloadVisible })**: 全屏预览图片/附件。
  - **说明**: 组件获取到图片、附件类数据时，如希望在组件内可点击图片进行预览，则可引入 `FileViewer` 组件，即可实现预览。
  - **注意事项**: 需配合 `e.stopPropagation()` 使用，防止触发父级点击事件。
  - **参数**:
    - `files`: `file[]` (必填) - 文件对象数组，从数据源获取到的图片、附件字段的数据，其 value 值即为文件对象数组。
    - `currentIndex`: `number` (可选) - 打开文件预览器时定位到文件数组的第几个文件，从 0 开始，留空默认为第一个图片。
    - `downloadVisible`: `boolean` (可选) - 是否显示文件的下载按钮，默认为 true。
  - **示例代码**:
    ```javascript
    // 引入页面客户端工具包，并提取出 previewFiles 方法
    import { previewFiles } from '@huoban/page-client-toolkit';

    export default function (props) {
      const item_data  = props?.data?.item_data;
      return (
        <ul className="list-none p-0">
           {item_data?.items.map((item, index) => (
            <li
              key={index}
              className="hover:bg-[var(--page-widget-main-4)] leading-[20px] py-2 px-2 rounded-[6px] flex items-center cursor-pointer"
              onClick={() => {item_data?.onItemClick(item);}}
            >
              {/* 以 onClick 点击事件的形式调用预览文件方法，参数传入文件对象的数组 */}
              <img
                src={item?.cover?.value[0].link?.medium}
                className="w-[80px] h-[60px] rounded-[6px] object-cover mr-[8px] cursor-pointer"
                onClick={(e) => {
                  previewFiles({
                  	files: item?.cover?.value,
                  	currentIndex: 0,
                  	downloadVisible: false
                  });
                  e.stopPropagation();
                }}
              />
              <span>{item?.title?.value}</span>
            </li>
          ))}
        </ul>
      );
    }
    ```

- **localize(text, { 'zh-CN': '...', 'en-US': '...' })**: 多语言支持。
  - **说明**: 在开发自定义组件时，如要处理中英文语言的切换问题，则需使用 `localize()` 方法，提供中文、英文的语言文本，系统会根据用户所选的语言环境进行自动调用。
